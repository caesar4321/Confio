require_relative '../node_modules/react-native/scripts/react_native_pods'

# Disable VisionCamera Frame Processors to avoid worklets-core issues
$VCEnableFrameProcessors = false

# Force disable New Architecture to prevent React Native Screens crashes
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, '15.1'

# Didit iOS SDK: 'all' = auto-capture + NFC, as before 4.x. Set before
# use_native_modules!, which loads the wrapper's podspec that reads it.
require 'json'
$DiditSdkIosVariant = 'all'
didit_sdk_ios_version = JSON.parse(
  File.read(File.join(__dir__, '../node_modules/@didit-protocol/sdk-react-native/package.json'))
).dig('diditNativeSdkVersions', 'ios')
prepare_react_native_project!

# Flipper is disabled due to Firebase use_frameworks requirement
# flipper_config = ENV['NO_FLIPPER'] == '1' ? FlipperConfiguration.disabled : FlipperConfiguration.enabled

# Firebase requires frameworks linkage
use_frameworks! :linkage => :static

target 'Confio' do
  config = use_native_modules!

  # The release the wrapper depends on (its diditNativeSdkVersions.ios), not
  # `main`, which drifts from it and breaks `pod install`.
  pod 'DiditSDK/All', :podspec => "https://raw.githubusercontent.com/didit-protocol/sdk-ios/#{didit_sdk_ios_version}/DiditSDK.podspec"
  
  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is enabled for better debugging and performance
    :hermes_enabled => true,
    # Fabric is disabled - using old architecture
    :fabric_enabled => false,
    # An absolute path to your application root
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # fmt 11.0.2 (bundled by React Native 0.79) only turns consteval off for
    # Apple clang < 14. Apple clang 21 (Xcode 27) rejects its consteval format
    # strings ("call to consteval function ... is not a constant expression"),
    # so extend that rule to every Apple clang: format strings are then checked
    # at run time, as they already were on older Apple clang. Pods/ is
    # regenerated by `pod install`, hence the patch here. Remove once React
    # Native ships a fmt with the upstream fix.
    fmt_base = File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      fmt_text = File.read(fmt_base)
      fmt_old = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L\n" \
                "#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14."
      fmt_new = "#elif defined(__apple_build_version__)\n" \
                "#  define FMT_USE_CONSTEVAL 0  // Confio Podfile: consteval format strings break on Apple clang 21+."
      if fmt_text.include?(fmt_old)
        File.chmod(0644, fmt_base)
        File.write(fmt_base, fmt_text.sub(fmt_old, fmt_new))
      elsif !fmt_text.include?(fmt_new)
        Pod::UI.warn 'fmt consteval patch not applied: fmt/base.h changed; check the Xcode 27 build.'
      end
    end

    # Standard fixes for React Native
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        definitions = Array(config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
        cleaned_definitions = definitions.flat_map { |value| value.to_s.split(/\s+/) }.reject do |value|
          [
            'REACT_NATIVE_DEBUGGER_ENABLED=1',
            'REACT_NATIVE_DEBUGGER_ENABLED_DEVONLY=1',
            'REACT_NATIVE_DEBUGGER_ENABLED=1REACT_NATIVE_DEBUGGER_ENABLED_DEVONLY=1',
          ].include?(value)
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = cleaned_definitions if cleaned_definitions.any?

        # Disable bitcode
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        
        # Current native dependencies support Apple Silicon simulators.
        config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
        
        # Minimum iOS deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # Fix for React Native Screens sheet presentation
        if target.name == 'RNScreens'
          config.build_settings['RCT_NEW_ARCH_ENABLED'] = '0'
        end

        if target.name == 'React-jsinspector'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS[config=*Debug*]'] = '$(inherited)'
        end
      end
    end
  end
end
