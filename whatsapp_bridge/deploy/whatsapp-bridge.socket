# /etc/systemd/system/whatsapp-bridge.socket — Django (user nginx) may call the bridge; nobody else.
[Unit]
Description=whatsapp-bridge socket

[Socket]
ListenStream=/run/whatsapp-bridge/bridge.sock
SocketUser=whatsapp-bridge
SocketGroup=nginx
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
